# ============================================================
# .gitignore — astock (Python 3.9+ 项目)
# 参考 GitHub 官方 Python.gitignore 并结合本仓库实际情况扩展。
# 条目按类型分组；注释用中文说明每组的意图。
# ============================================================

# ------------------------------------------------------------
# Byte-compiled / optimized / DLL files
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------------------------------------------------
# C extensions
# ------------------------------------------------------------
*.so
*.dylib
*.dll

# ------------------------------------------------------------
# Distribution / packaging
# ------------------------------------------------------------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------
# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
# ------------------------------------------------------------
*.manifest
*.spec

# ------------------------------------------------------------
# Installer logs
# ------------------------------------------------------------
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------
# Unit test / coverage reports
# ------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
cover/

# ------------------------------------------------------------
# Translations
# ------------------------------------------------------------
*.mo
*.pot

# ------------------------------------------------------------
# Type checkers / linters 缓存
# ------------------------------------------------------------
.mypy_cache
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache
.ruff_cache/
.pylint.d/
.pytest_cache
.pytest_cache/

# ------------------------------------------------------------
# Jupyter Notebook
# ------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ------------------------------------------------------------
# pyenv / pipenv / Poetry / PDM
# ------------------------------------------------------------
.python-version
Pipfile.lock
poetry.lock
.pdm.toml
.pdm-python
.pdm-build/
__pypackages__/

# ------------------------------------------------------------
# Virtual environments
# ------------------------------------------------------------
.env
.envrc
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------
# Framework-specific (保留以备将来扩展 Web / 异步 / ORM 生态)
# ------------------------------------------------------------
# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask
instance/
.webassets-cache

# Scrapy
.scrapy

# Sphinx 文档
docs/_build/

# Celery
celerybeat-schedule
celerybeat.pid

# SageMath
*.sage.py

# Spyder / Rope
.spyderproject
.spyproject
.ropeproject

# mkdocs
/site

# ------------------------------------------------------------
# IDE / 编辑器
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ------------------------------------------------------------
# 操作系统杂项
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# astock 项目专属
# ------------------------------------------------------------
# 数据目录：SQLite 文件、CSV/Excel/JSON 输出、akshare 缓存、日志
data/

# 本地数据库文件（若用户把 SQLite 放在 data/ 以外的位置）
*.db
*.sqlite
*.sqlite3
*.parquet
*.pickle

# 日志
*.log
logs/

# 用户本地配置覆盖（不入库，避免把个人 token 等写入仓库）
config/local.yaml
config/*.local.yaml

# 环境变量（tushare token、数据库连接串等）
.env
.env.local
.env.*.local

# 临时脚本与草稿
*.tmp
*.bak
_scratch/
_patch_*.py

# 敏感信息 / 密钥（防止意外入库）
*.pem
*.key
secrets.yaml
secrets.yml
